# /etc/livecap/<environment>.env, owned by root, mode 0600. One file per environment, each
# with its own LiveKit project and Gladia key. See docs/deploy.md.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GLADIA_API_KEY=
GLADIA_REGION=eu-west

# Bearer secret of POST /rooms/{room}/join, shared with the application that calls it.
LIVECAP_JOIN_SECRET=

# Loopback only: Caddy terminates TLS in front. One port per environment.
LIVECAP_LISTEN_ADDR=127.0.0.1:8791

LIVECAP_MAX_ROOMS=15
LIVECAP_DRAIN_TIMEOUT_SECS=7200

# Keep `info`. At `debug` the LiveKit SDK prints whole signalling messages (participant
# attributes, TURN credentials): never turn it on for `livekit`, `livekit_api` or `libwebrtc`.
RUST_LOG=info
